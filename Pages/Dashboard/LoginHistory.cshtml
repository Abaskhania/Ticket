@page
@model SupportTicketSystem.Pages.Dashboard.LoginHistoryModel
@{
}
<div class="text-start">
    
    <a class=" btn btn-light"  asp-area="" asp-page="manageuser">بازگشت
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5"></path>
        </svg>
    </a>
</div>
<h4>تاریخچه ورود و خروج کاربر</h4>
<hr />
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                ردیف
            </th>
            <th>
                نام کاربری
            </th>
            <th>
                IP
            </th>
            <th>
                تاریخ ورود
            </th>
            <th>
                تاریخ خروج
            </th>

        </tr>
    </thead>
    <tbody>
        @{
            int index = 1; // Start index from 1
        }
        @foreach (var userlogin in Model.UserLoginHistory)
        {
            <tr>
                <td>

                    @index
                </td>
                <td>@userlogin.UserId</td>
                <td>@userlogin.IpAddress</td>
                <td>
                    @userlogin.LoginTime_Persian
                </td>
                <td>
                    @userlogin.LogoutTime_Persian
                </td>

                

            </tr>
            index++;
        }
    </tbody>
</table>