@page
@model SupportTicketSystem.Pages.Dashboard.ManageUserModel
@{
}
<div class="text-start">    
    <a class=" btn btn-primary"  asp-area="" asp-page="../Register" >کاربر جدید</a> 
    <a class=" btn btn-light" asp-area="" asp-page="admin">
        بازگشت
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5"></path>
        </svg>
    </a>
</div>
<h4>لیست کاربران</h4>
<hr />
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                ردیف
            </th>
            <th>
                نام کاربری
            </th>
            <th>
                عملیات
            </th>
                               
        </tr>
    </thead>
    <tbody>
        @{
            int index = 1; // Start index from 1
        }
        @foreach (var user in Model.satraUsers)
        {
            <tr>
                <td>

                    @index
                </td>
                <td>
                    @user.Username
                </td>
                <td>
                    <a class="link-primary"  asp-area="" asp-page="ResetPassword" asp-route-id="@user.Id.ToString()">بازنشانی رمز عبور</a>&nbsp;| &nbsp;
                    <a class="link-primary" asp-area="" asp-page-handler="ChangeState" asp-route-id="@user.Id.ToString()">@(user.IsValid ? "فعال" : "غیرفعال")</a>&nbsp;| &nbsp;
                    <a class="link-primary" asp-area="" asp-page="LoginHistory" asp-route-id="@user.Id.ToString()">تاریخچه ورود </a>
                </td>
                

                                        
            </tr>
            index++;
        }
    </tbody>
</table>