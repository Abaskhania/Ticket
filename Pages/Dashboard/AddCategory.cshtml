@page
@model SupportTicketSystem.Pages.Dashboard.AddCategoryModel
@{
}
<div class="text-start">

    <a class=" btn btn-light" asp-area="" asp-page="IT">
        بازگشت
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5"></path>
        </svg>
    </a>
</div>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white p-4">
                    <h4 class="mb-0">ایجاد دسته بندی جدید</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Name" class="form-label">عنوان دسته بندی</label>
                            <input asp-for="Input.Name" class="form-control" placeholder="عنوان دسته بندی را وارد کنید" />
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>
                       

                        

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">ثبت</button>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Result))
                        {
                            <div class="mb-3 mt-3 alert alert-success p-3">
                                <p>@Model.Result</p>
                            </div>

                        }
                    </form>
                    <table class="table table-bordered bg-white">
                        <thead>
                            <tr>
                                <th>
                                    ردیف

                                </th>
                                <th>
                                    عنوان دسته بندی
                                </th>
                                
                            </tr>
                        </thead>
                        <tbody>
                            @{
    int index = 1; // Start index from 1
}
                            @foreach (var item in Model.Categories)
                            {
                                <tr>
                                    <td>

                                        @index
                                    </td>
                                    <td>

                                        @item.Name
                                    </td>
                                    

                                
                               

                      
                                
                        

                    

                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>