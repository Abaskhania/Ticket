<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SupportTicketSystem</title>

    
    <link href="~/css/input.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/output.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js" ></script>
    <link href="~/css/fonts.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-vazir bg-gray-100 text-gray-800">

    
    
    <header class=" shadow mb-4" style="background-color:#E3F2FD">
        <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="text-xl font-bold text-gray-700">
               <img src="~/img/logo.png"  style="width:150px"/>
                @* <h1>سامانه تیکتینگ</h1> *@
                
            </div>
            <nav class="flex gap-4 text-sm">
                @if (User.Identity!.IsAuthenticated)
                {

                    <a href="/Logout"
                   class="flex items-center gap-2 rounded-xl border border-red-100 bg-white px-4 py-2.5 text-sm font-semibold text-red-600 shadow-sm transition duration-200 hover:border-red-200 hover:bg-red-50 hover:shadow-md">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>

                    <span>خروج از حساب</span>
                </a>
                }

            </nav>
        </div>
    </header>

   
    <main class="w-full mx-auto px-4">
        @RenderBody()
    </main>

    
    <footer class="mt-8 py-4 text-center text-gray-500 text-sm border-t ">
        اداره‌ کل فناوری و سامانه‌های نوین
        مدیریت فنی و فناوری اطلاعات © ۱۴۰۵
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

</body>
</html>
